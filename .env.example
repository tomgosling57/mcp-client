# LLM provider and model, combined into LiteLLM's "provider/model" id.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Optional. LiteLLM falls back to provider-native keys such as
# GEMINI_API_KEY or OPENAI_API_KEY when this is unset.
# LLM_API_KEY=your-key-here

# Optional overrides.
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7
# LLM_API_BASE=https://example.test/v1

# Log level for the file logs (default: WARNING hides info-level chatter).
# LOG_LEVEL=INFO
